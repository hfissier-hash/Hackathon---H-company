# Copier en .env (jamais commité) et remplir.
# Le jeton Hugging Face est lu dans ~/.cache/huggingface/token (hf auth login).
# La clé H Company est gérée par la commande holo (holo login), pas par ce fichier.
SUPABASE_URL=
SUPABASE_ANON_KEY=          # clé publique : lecture du catalogue uniquement
SUPABASE_SERVICE_ROLE_KEY=  # clé secrète (sb_secret_…) : routes serveur et worker, jamais côté navigateur
