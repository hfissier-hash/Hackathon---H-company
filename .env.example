# Copier en .env (jamais commité) et remplir.
# Les scripts de prototypes lisent pour l'instant le jeton Hugging Face dans ~/.cache/huggingface/token.
HF_TOKEN=
H_COMPANY_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=          # clé publique : lecture du catalogue uniquement
SUPABASE_SERVICE_ROLE_KEY=  # clé serveur : workers uniquement, jamais côté navigateur
