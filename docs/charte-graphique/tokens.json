{
  "name": "Nestr",
  "version": "1.0 (2026-11-19)",
  "logo": {
    "wordmark": "nestr.",
    "monogram": "(n.)™",
    "accentLetters": "le « n » initial et le point final, toujours de la même couleur : lingon, pin, encre ou blanc",
    "font": "Bricolage Grotesque 800",
    "nameInSentence": "Nestr"
  },
  "colors": {
    "pine": { "hex": "#1F4D3F", "use": "marque, titres, boutons", "contrastOnSurface": 9.2 },
    "pineDeep": { "hex": "#14332A", "use": "fonds sombres, couvertures" },
    "lingon": { "hex": "#C9432F", "use": "accent du logo, appels à l'action", "contrastOnSurface": 4.6, "contrastOnPineDeep": 2.8 },
    "onLingon": { "hex": "#FFF8F2", "use": "texte sur lingon", "contrastOnLingon": 4.6 },
    "sun": { "hex": "#F2C14E", "use": "accent sur fond sombre uniquement", "contrastOnPineDeep": 8.1, "contrastOnSurface": 1.6 },
    "surface": { "hex": "#FAFAF6", "use": "fond principal" },
    "birch": { "hex": "#EEE7D7", "use": "fonds de section, cartes" },
    "line": { "hex": "#D5D8CE", "use": "bordures, séparateurs" },
    "ink": { "hex": "#14231F", "use": "texte courant", "contrastOnSurface": 15.6 },
    "inkMuted": { "hex": "#4A5A55", "use": "texte secondaire", "contrastOnSurface": 7.0 },
    "inkOnDark": { "hex": "#EEF1EC", "use": "texte sur pin profond" },
    "ok": { "hex": "#2F6FA3", "use": "« ça rentre », validation" },
    "warn": { "hex": "#A65A12", "use": "alerte : trop grand, passage serré" }
  },
  "typography": {
    "display": { "family": "Bricolage Grotesque", "weights": [700, 800], "use": "titres, logo" },
    "body": { "family": "Figtree", "weights": [400, 600, 700], "use": "texte" },
    "data": { "family": "JetBrains Mono", "weights": [500], "use": "mesures, prix, données" },
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600..800&family=Figtree:wght@400;600;700&family=JetBrains+Mono:wght@500&display=swap",
    "slideScalePx": [120, 72, 44, 32, 24],
    "appBodyPx": [16, 17]
  },
  "logoVariants": [
    { "file": "logos/logo-principal.svg", "background": "surface", "accent": "lingon" },
    { "file": "logos/logo-principal-fond-sombre.svg", "background": "pineDeep", "accent": "lingon", "note": "grands formats seulement" },
    { "file": "logos/logo-pin.svg", "background": "surface", "accent": "pine" },
    { "file": "logos/logo-mono-encre.svg", "background": "surface", "accent": "ink" },
    { "file": "logos/logo-mono-blanc.svg", "background": "pineDeep", "accent": "surface" }
  ],
  "rules": [
    "Le « n » et le point ont toujours la même couleur.",
    "Zone de protection : un vide égal à la hauteur du « n » autour du logo.",
    "Logotype : 80 px de large minimum ; en dessous, monogramme (24 px minimum).",
    "Lingon sur pin profond seulement en grand (contraste 2,8) ; en petit, utiliser la version blanche.",
    "Pas de jaune (soleil) dans le logo ; soleil jamais en texte sur fond clair.",
    "Pas de déformation, d'ombre ni de contour sur le logo."
  ]
}
